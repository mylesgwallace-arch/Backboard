{
  "name": "Backboard — NBA Analytics",
  "short_name": "Backboard",
  "description": "NBA win probabilities, live games, playoff odds and player forecasts from a model that shows its work.",
  "id": "/dashboard",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "background_color": "#141414",
  "theme_color": "#141414",
  "categories": ["sports", "news"],
  "icons": [
    { "src": "/media/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/media/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/media/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/media/icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Tonight", "url": "/tonight", "icons": [{ "src": "/media/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Pick'em", "url": "/pickem", "icons": [{ "src": "/media/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Playoffs", "url": "/playoffs", "icons": [{ "src": "/media/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
