# NBA data
data/

# Python virtual environment
.venv/

# Python cache
__pycache__/
*.py[cod]

# Generated model files. Most artifacts under models/ are regenerated by
# src/train_baseline_model.py or src/player_impact.py and are not tracked.
# The baseline logistic model and its metrics are small, versioned reference
# artifacts that document the currently validated baseline, so they are
# tracked as an explicit exception below.
models/*
!models/baseline_logistic.pkl
!models/baseline_metrics.json
# Validation reports for features built on the frozen model (small JSON,
# tracked so the evidence cited in PROJECT_CONTEXT.md is reviewable).
!models/forward_projection_backtest.json
!models/playoff_validation.json
# The margin/total model is small and served by the predict_margin tool.
!models/margin_model.pkl
!models/margin_metrics.json
!models/roster_adjustment_backtest.json
!models/nl_eval_report.json

# Environment variables
.env